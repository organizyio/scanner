* text=auto

# Bash rejects CRLF on `set -o pipefail` (option becomes `pipefail^M`).
*.sh text eol=lf

# Retain upstream third-party notices byte-for-byte on every host.
licenses/upstream/** -text whitespace=-blank-at-eof,-blank-at-eol,cr-at-eol

# Synthetic PDF xref offsets and fixture digests require exact bytes on Windows.
crates/metadata/tests/fixtures/*.pdf -text
crates/metadata/tests/fixtures/*.docx -text
crates/metadata/tests/fixtures/*.tiff -text
