  "decisions": {
    "zbus": "No compatible published AccessKit migration to zbus 6. accesskit_unix 0.24.1 requires ^5.19 and atspi_common 0.21.1 requires zvariant ^5.15. zbus 6.2.0 needs Rust 1.89, above pinned 1.88. Do not force transitive upgrades.",
    "macos_patch": "0.27.2 changes SubclassingAdapter KVO attachment/drop behavior and adds integration tests. Requires separate source/attach-lifecycle and native qualification; retain tested 0.27.1.",
    "windows_patch": "0.35.2 changes password-input detection to the consumer helper. No shutdown-path change in the reviewed source delta; not evidence for fixing historical STA timeout. Retain tested 0.35.1 pending separate adapter qualification.",
    "fyne": "Retain shutdown and Cocoa event-wait adaptations; latest release does not establish equivalence. No toolkit adoption in this review.",
    "root_png_inout": "Reviewed latest versions equal the already-qualified root versions."
  },
